# Core
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ateliervelo?schema=public
REDIS_URL=redis://localhost:6379

# Auth (Keycloak)
KEYCLOAK_REALM=atelier-velo
KEYCLOAK_CLIENT_ID=atelier-api
KEYCLOAK_CLIENT_SECRET=replace_me
KEYCLOAK_ISSUER=http://localhost:8080/realms/atelier-velo

# HubSpot (Private App Token or OAuth)
HUBSPOT_PRIVATE_APP_TOKEN=pat-xxx
HUBSPOT_APP_ID=000000
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_WEBHOOK_SECRET=

# Payments
STRIPE_API_KEY=sk_test_xxx
STRIPE_TERMINAL_LOCATION=tml_xxx
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
SUMUP_REDIRECT_URI=http://localhost:3001/payments/sumup/oauth/callback

# App
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
