# ===========================================
# Atelier Vélo+ — Environment Variables Example
# Copie ce fichier en `.env` et remplis les valeurs.
# ===========================================

NODE_ENV=development

# ===========================================
# BASE DE DONNÉES SQLITE (Electron local)
# ===========================================
DATABASE_URL="file:./prisma/data/atelier-velo.db"

# ===========================================
# SÉCURITÉ — Obligatoire en production (>= 32 chars)
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ===========================================
JWT_SECRET=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# EMAIL — Resend (transactionnel)
# ===========================================
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ===========================================
# EMAIL — SMTP (dev / fallback)
# ===========================================
MAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===========================================
# BOUTIQUE (méta affichée sur factures / emails)
# ===========================================
SHOP_NAME=Atelier Vélo+
SHOP_EMAIL=
SHOP_PHONE=
SHOP_ADDRESS1=
SHOP_ZIP=
SHOP_CITY=
SHOP_COUNTRY=France
SHOP_SIRET=
SHOP_TVA=
SHOP_RCS=
SHOP_CAPITAL=
SHOP_INSURANCE=

# ===========================================
# BOOKING PUBLIC (tunnel Cloudflare)
# ===========================================
NEXT_PUBLIC_BOOKING_URL=

# URL de base utilisée par les liens (success Stripe, OAuth redirect, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# API ATELIER — URL du Worker Cloudflare qui gère vente éditeur + activation
# (déployé depuis workers/, voir workers/README.md).
# Sans cette URL, l'onglet "Activer un code d'achat" reste désactivé dans l'app.
# ===========================================
NEXT_PUBLIC_ATELIER_API_BASE=https://atelier-velo-api.YOUR-SUBDOMAIN.workers.dev

# ===========================================
# SENTRY — Capture des erreurs en production (opt-in)
# DSN distinct serveur et client.
# ===========================================
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_VERSION=1.1.0
SENTRY_FORCE=

# ===========================================
# AUTO-UPDATE ELECTRON — Cloudflare R2
# ===========================================
AUTO_UPDATE_FEED_URL=

# Pour publier (scripts/publish-update-r2.mjs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
