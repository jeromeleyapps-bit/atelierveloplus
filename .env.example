# ===========================================
# Atelier Vélo+ — Environment Variables Example
# Copie ce fichier en `.env` et remplis les valeurs.
# ===========================================

NODE_ENV=development

# ===========================================
# BASE DE DONNÉES SQLITE (Electron local)
# ===========================================
DATABASE_URL="file:./prisma/data/atelier-velo.db"

# ===========================================
# SÉCURITÉ — Obligatoire en production (>= 32 chars)
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ===========================================
JWT_SECRET=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# EMAIL — Resend (transactionnel)
# ===========================================
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ===========================================
# EMAIL — SMTP (dev / fallback)
# ===========================================
MAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===========================================
# BOUTIQUE (méta affichée sur factures / emails)
# ===========================================
SHOP_NAME=Atelier Vélo+
SHOP_EMAIL=
SHOP_PHONE=
SHOP_ADDRESS1=
SHOP_ZIP=
SHOP_CITY=
SHOP_COUNTRY=France
SHOP_SIRET=
SHOP_TVA=
SHOP_RCS=
SHOP_CAPITAL=
SHOP_INSURANCE=

# ===========================================
# BOOKING PUBLIC (tunnel Cloudflare)
# ===========================================
NEXT_PUBLIC_BOOKING_URL=

# URL de base utilisée par les liens (success Stripe, OAuth redirect, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# STRIPE — Vente éditeur (Checkout)
# Mode piloté par STRIPE_MODE (test|live). Défaut : déduit de NODE_ENV.
# ===========================================
STRIPE_MODE=test

# Clés API (renseigne au moins les TEST en dev)
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_xxx
STRIPE_SECRET_KEY_TEST=sk_test_xxx
STRIPE_WEBHOOK_SECRET_TEST=whsec_test_xxx

STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=

# Price IDs Stripe (créés sur dashboard, mode test ET live)
STRIPE_PRICE_BASIQUE_TEST=price_xxx
STRIPE_PRICE_PRO_TEST=price_xxx
STRIPE_PRICE_PRO_LIFETIME_TEST=price_xxx
STRIPE_PRICE_BASIQUE_LIVE=
STRIPE_PRICE_PRO_LIVE=
STRIPE_PRICE_PRO_LIFETIME_LIVE=

# ===========================================
# STRIPE CONNECT — Permet à chaque atelier de connecter SON compte Stripe
# Créer une Platform Stripe Connect sur dashboard → Settings → Connect.
# ===========================================
STRIPE_CONNECT_CLIENT_ID_TEST=ca_xxx
STRIPE_CONNECT_CLIENT_ID_LIVE=

# ===========================================
# LICENCE — Clé privée RSA utilisée par le serveur pour signer les clés générées
# par le webhook + /api/license/redeem. NE JAMAIS embarquer dans la dist Electron.
# Option 1 : fichier sur le serveur, pointé par chemin
# Option 2 : contenu PEM en variable (échapper les \n en \\n)
# ===========================================
LICENSE_PRIVATE_KEY_PATH=./license-generator/private-key.pem
# LICENSE_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# ===========================================
# SENTRY — Capture des erreurs en production (opt-in)
# DSN distinct serveur et client.
# ===========================================
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_VERSION=1.1.0
SENTRY_FORCE=

# ===========================================
# AUTO-UPDATE ELECTRON — Cloudflare R2
# ===========================================
AUTO_UPDATE_FEED_URL=

# Pour publier (scripts/publish-update-r2.mjs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
