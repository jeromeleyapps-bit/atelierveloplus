# Variables d'environnement pour build Electron macOS
# Ces valeurs seront remplacées par l'utilisateur final

# Base de données (chemin relatif, sera résolu par Electron)
DATABASE_URL="file:./prisma/data/atelier-velo.db"

# Sécurité - DOIVENT être définies par l'utilisateur
ENCRYPTION_KEY="CHANGE_ME_IN_PRODUCTION_64_CHARS_MINIMUM_REQUIRED_HERE"
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_128_CHARS_MINIMUM_REQUIRED_FOR_SECURITY"

# Application
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED=1
