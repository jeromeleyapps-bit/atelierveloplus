{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:tunnel": "powershell -ExecutionPolicy Bypass -File ./start-tunnel.ps1",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "lint:ci": "next lint --max-warnings=0",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "list": "node -p \"Object.keys(require('./package.json').scripts).join('\\n')\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run --coverage",
    "icons:generate": "node ./scripts/generate-icons.mjs",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:reset": "prisma generate && prisma migrate reset --force && prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "ts-node scripts/seed.ts",
    "audit:deps": "depcheck"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@hubspot/api-client": "^13.4.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@mui/x-data-grid": "^6.18.7",
    "@prisma/client": "6.16.3",
    "@supabase/supabase-js": "^2.58.0",
    "@upstash/ratelimit": "^1.2.0",
    "@upstash/redis": "^1.35.5",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^12.23.22",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.2",
    "next": "^14.2.10",
    "nodemailer": "^6.9.13",
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^18.3.5",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.0",
    "depcheck": "^1.4.7",
    "eslint": "8.57.0",
    "eslint-config-next": "^14.2.10",
    "png-to-ico": "^3.0.1",
    "prisma": "^6.16.2",
    "sharp": "^0.33.3",
    "ts-node": "^10.9.2",
    "typescript": "5.6.2",
    "vitest": "^1.6.0"
  },
  "description": "",
  "main": "next.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "prisma": {
    "seed": "node prisma/seed.cjs"
  }
}
