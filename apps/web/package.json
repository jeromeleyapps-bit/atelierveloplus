{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "lint:ci": "next lint --max-warnings=0",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "list": "node -p \"Object.keys(require('./package.json').scripts).join('\\n')\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run --coverage",
    "icons:generate": "node ./scripts/generate-icons.mjs",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:reset": "prisma generate && prisma migrate reset --force && prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "ts-node scripts/seed.ts",
    "audit:deps": "depcheck",
    "electron": "electron .",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "next build && electron-builder",
    "pack": "next build && electron-builder --dir",
    "dist": "next build && electron-builder"
  },
  "build": {
    "appId": "com.ateliervelo.app",
    "productName": "Atelier Velo+",
    "directories": {
      "output": "dist",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "prisma/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atelier Velo+",
      "installerIcon": "public/logo.png",
      "uninstallerIcon": "public/logo.png"
    }
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@hubspot/api-client": "^13.4.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@mui/x-data-grid": "^6.18.7",
    "@prisma/client": "^6.16.2",
    "@supabase/supabase-js": "^2.58.0",
    "@upstash/ratelimit": "^1.2.0",
    "@upstash/redis": "^1.33.0",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^12.23.22",
    "next": "^14.2.10",
    "nodemailer": "^6.9.13",
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^18.3.5",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.0",
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.7",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "electron-is-dev": "^3.0.1",
    "eslint": "8.57.0",
    "eslint-config-next": "^14.2.10",
    "png-to-ico": "^3.0.1",
    "prisma": "^6.16.2",
    "sharp": "^0.33.3",
    "ts-node": "^10.9.2",
    "typescript": "5.6.2",
    "vitest": "^1.6.0",
    "wait-on": "^9.0.1"
  },
  "description": "Atelier Velo+ - Gestion d'atelier velo",
  "main": "electron/main.js",
  "keywords": [
    "atelier",
    "velo",
    "gestion"
  ],
  "author": "Jerome Leyssard",
  "license": "ISC",
  "homepage": "./",
  "type": "commonjs",
  "prisma": {
    "seed": "node prisma/seed.cjs"
  }
}