generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model InvoicePayment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  method    String?
  paidAt    DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model CustomerBike {
  id             String      @id @default(cuid())
  customerId     String
  index          Int
  brand          String?
  model          String?
  nationalFileId String?
  serialNumber   String?
  color          String?
  notes          String?
  // Spécifications techniques pour historique
  wheelSize      String?     // Ex: "700c", "26\"", "27.5\"", "29\""
  tireSize       String?     // Ex: "700x25c", "26x2.1"
  frameMaterial  String?     // Ex: "Aluminium", "Carbone", "Acier"
  frameSize      String?     // Ex: "M", "54cm"
  brakeType      String?     // Ex: "Disque hydraulique", "V-Brake", "Cantilever"
  gearSystem     String?     // Ex: "Shimano 105", "SRAM GX"
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  customer       Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrders     WorkOrder[]

  @@unique([customerId, index])
}

model ServiceRate {
  id          String   @id @default(cuid())
  name        String   // Nom de la prestation (ex: "Révision complète")
  description String?  // Description détaillée
  priceHT     Float    // Prix HT
  bikeType    String?  // Type de vélo (ex: "VTT", "Route", "Ville", "Électrique", null = tous)
  category    String?  // Catégorie (ex: "Entretien", "Réparation", "Diagnostic")
  duration    Int?     // Durée estimée en minutes
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([bikeType])
  @@index([category])
}

model GlobalSetting {
  key   String  @id
  value String?
}

model PricingMargin {
  id          String   @id @default(cuid())
  minPrice    Float    // Prix minimum de la tranche (inclus)
  maxPrice    Float?   // Prix maximum de la tranche (exclus), null = infini
  coefficient Float    // Coefficient multiplicateur
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([minPrice])
}

model InvoiceSequence {
  id         String   @id @default(cuid())
  year       Int      @unique
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CatalogItem {
  id                 String          @id @default(cuid())
  sku                String?         @unique
  category           CatalogCategory
  name               String
  priceHT            Float
  priceTTC           Float
  vatRate            Float
  active             Boolean         @default(true)
  stockQty           Int             @default(0)
  minStock           Int             @default(0)
  reorderQty         Int             @default(0)
  location           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  purchasePriceHT    Float?
  purchasePriceTTC   Float?
  supplierVatEnabled Boolean         @default(false)
  marginCoeff        Float?          @default(1)
  stockMovements     StockMovement[]
  supplierItems      SupplierItem[]
  supplierOffers     SupplierOffer[]
}

model Customer {
  id             String          @id @default(cuid())
  email          String?         @unique
  firstName      String?
  lastName       String?
  phone          String?
  address1       String?
  address2       String?
  zip            String?
  city           String?
  country        String?
  bikeBrand      String?
  bikeModel      String?
  nationalFileId String?
  shipAddress1   String?
  shipAddress2   String?
  shipZip        String?
  shipCity       String?
  shipCountry    String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bookings       Booking[]
  communications Communication[]
  bikes          CustomerBike[]
  workOrders     WorkOrder[]
}

model Invoice {
  id              String           @id @default(cuid())
  workOrderId     String?
  number          String?          @unique
  issueDate       DateTime?
  status          String           @default("draft")
  type            String           @default("invoice")
  parentId        String?
  pricingMode     String           @default("HT_TVA")
  currency        String           @default("EUR")
  vatRate         Float            @default(20)
  laborRate       Float            @default(60)
  subtotalHT      Float            @default(0)
  vatAmount       Float            @default(0)
  totalTTC        Float            @default(0)
  discountAmount  Float?           @default(0)
  paidAt          DateTime?
  paymentMethod   String?
  cancelledAt     DateTime?
  cancelledReason String?
  dueDate         DateTime?
  reminderCount   Int              @default(0)
  lastReminderAt  DateTime?
  validUntil      DateTime?
  convertedAt     DateTime?
  convertedToId   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workOrder       WorkOrder?       @relation(fields: [workOrderId], references: [id])
  cashPayments    CashRegister[]
  lines           InvoiceLine[]
  payments        InvoicePayment[]
}

model InvoiceLine {
  id              String  @id @default(cuid())
  invoiceId       String
  type            String  @default("part")
  description     String
  qty             Float   @default(1)
  unitPriceHT     Float?
  unitPriceTTC    Float?
  vatRate         Float?
  totalHT         Float   @default(0)
  totalTTC        Float   @default(0)
  partId          String?
  purchasePriceHT Float?
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id        String      @id @default(cuid())
  itemId    String
  type      String
  qty       Int
  refType   String?
  refId     String?
  note      String?
  createdAt DateTime    @default(now())
  item      CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Supplier {
  id            String               @id @default(cuid())
  name          String
  website       String?
  connectorType String               @default("MOCK")
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  credentials   SupplierCredential[]
  items         SupplierItem[]
  offers        SupplierOffer[]
}

model SupplierCredential {
  id         String   @id @default(cuid())
  supplierId String
  userId     String
  username   String?
  password   String?
  extraJson  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model SupplierItem {
  id               String       @id @default(cuid())
  supplierId       String
  catalogItemId    String?
  supplierSku      String
  ean              String?
  lastPriceHT      Float?
  lastAvailability String?
  lastCheckedAt    DateTime?
  favorite         Boolean      @default(false)
  catalogItem      CatalogItem? @relation(fields: [catalogItemId], references: [id])
  supplier         Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model SupplierOffer {
  id            String       @id @default(cuid())
  supplierId    String
  catalogItemId String?
  externalId    String?
  name          String
  description   String?
  reference     String?
  brand         String?
  price         Float
  priceHT       Float?
  currency      String       @default("EUR")
  availability  String?
  stock         Int?
  deliveryDays  Int?
  url           String?
  imageUrl      String?
  metadata      String?
  fetchedAt     DateTime     @default(now())
  expiresAt     DateTime
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])
  supplier      Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([catalogItemId])
  @@index([externalId])
  @@index([fetchedAt])
  @@index([expiresAt])
}

model WorkOrder {
  id                 String          @id @default(cuid())
  status             String          @default("created")
  customerId         String?
  bikeId             String?
  type               String?         @default("repair")
  estimatedMinutes   Int?
  hourlyRate         Float?
  appointmentDate    DateTime?       // Date et heure du RDV retour vélo
  calendarEventId    String?         // Lien vers l'événement calendrier
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  dueAt              DateTime?
  communications     Communication[]
  bike               CustomerBike?   @relation(fields: [bikeId], references: [id])
  customer           Customer?       @relation(fields: [customerId], references: [id])
  lines              WorkOrderLine[]
  invoices           Invoice[]
  calendarEvent      CalendarEvent?  @relation(fields: [calendarEventId], references: [id])

  @@index([customerId])
  @@index([bikeId])
  @@index([status])
}

model WorkOrderLine {
  id            String    @id @default(cuid())
  workOrderId   String
  type          String    // 'service' | 'part' | 'manual'
  description   String
  quantity      Int       @default(1)
  priceHT       Float
  vatRate       Float     // 0, 10, 20
  duration      Int?      // minutes (pour prestations)
  sourceId      String?   // ID de ServiceRate ou CatalogItem
  notes         String?   // Notes additionnelles
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  
  @@index([workOrderId])
  @@index([type])
}

model User {
  id             String           @id @default(cuid())
  name           String?
  email          String           @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  role           String           @default("user")
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  accounts       Account[]
  settings       AppSetting?
  systemSettings SystemSettings?
  cashRegisters  CashRegister[]
  sessions       Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AppSetting {
  id                  String   @id @default(cuid())
  userId              String   @unique
  shopName            String?
  shopEmail           String?
  shopPhone           String?
  address1            String?
  address2            String?
  zip                 String?
  city                String?
  country             String?
  pdfPrimary          String?
  legalFooter         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  capital             String?
  insurance           String?
  rcs                 String?
  siret               String?
  tva                 String?
  isAutoEntrepreneur  Boolean  @default(false)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Calendar: admin events visible internally; blocks that make time unavailable; client bookings
model CalendarEvent {
  id          String      @id @default(cuid())
  title       String
  description String?
  start       DateTime
  end         DateTime
  status      String      @default("planned")
  blocksAvail Boolean     @default(true)
  color       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workOrders  WorkOrder[] // Tickets liés à ce RDV
}

model CalendarBlock {
  id        String   @id @default(cuid())
  reason    String?
  start     DateTime
  end       DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id          String    @id @default(cuid())
  start       DateTime
  end         DateTime
  status      String    @default("pending")
  name        String
  email       String?
  phone       String?
  bike        String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])

  @@index([start, end])
  @@index([customerId])
}

model CalendarConfig {
  id             Int      @id @default(1)
  timezone       String   @default("Europe/Paris")
  slotMinutes    Int      @default(60)
  leadTimeHours  Int      @default(6)
  maxConcurrent  Int      @default(1)
  saturdayByAppt Boolean  @default(true)
  businessHours  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Communication {
  id          String     @id @default(cuid())
  customerId  String
  workOrderId String?
  invoiceId   String?
  type        String
  event       String
  recipient   String
  subject     String?
  content     String
  status      String
  provider    String     @default("hubspot")
  externalId  String?
  sentAt      DateTime?
  deliveredAt DateTime?
  error       String?
  metadata    String?
  createdAt   DateTime   @default(now())
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([customerId])
  @@index([workOrderId])
  @@index([status])
  @@index([event])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  event       String
  subject     String
  htmlContent String
  textContent String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([event])
}

model SMSTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  event     String
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([event])
}

model CashRegister {
  id          String   @id @default(cuid())
  type        String
  amount      Float
  description String?
  invoiceId   String?
  userId      String
  createdAt   DateTime @default(now())
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([createdAt])
  @@index([invoiceId])
  @@index([userId])
}

model SystemSettings {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  notificationsEnabled       Boolean  @default(true)
  emailNotificationsEnabled  Boolean  @default(true)
  activityLogsEnabled        Boolean  @default(true)
  autoBackupEnabled          Boolean  @default(false)
  backupFrequency            String   @default("weekly")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CatalogCategory {
  PIECES
  EQUIPEMENTS
  AUTRES
}
