// Prisma schema for PostgreSQL (production-ready)
// Run (in apps/web):
//   npx prisma generate
//   npx prisma migrate dev --name init
//
// Environment variables:
//   DATABASE_URL="postgresql://user:password@localhost:5432/atelier_velo?schema=public"

generator client {
  provider = "prisma-client-js"
}

enum CatalogCategory {
  PIECES
  EQUIPEMENTS
  AUTRES
}

// Partial payments recorded against invoices
model InvoicePayment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  method    String?
  paidAt    DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CustomerBike {
  id             String   @id @default(cuid())
  customerId     String
  index          Int
  brand          String?
  model          String?
  nationalFileId String?
  serialNumber   String?
  color          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, index])
}

model GlobalSetting {
  key   String  @id
  value String?
}

// Invoice number sequence per year
model InvoiceSequence {
  id         String   @id @default(cuid())
  year       Int      @unique
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CatalogItem {
  id              String   @id @default(cuid())
  sku             String?  @unique
  category        CatalogCategory
  name            String
  priceHT         Float
  priceTTC        Float
  vatRate         Float
  active          Boolean  @default(true)
  stockQty        Int      @default(0)
  minStock        Int      @default(0)
  reorderQty      Int      @default(0)
  location        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  purchasePriceHT Float?

  stockMovements StockMovement[]
  supplierItems  SupplierItem[]
  workOrderParts WorkOrderPart[]
}

model Customer {
  id             String   @id @default(cuid())
  email          String?  @unique
  firstName      String?
  lastName       String?
  phone          String?
  address1       String?
  address2       String?
  zip            String?
  city           String?
  country        String?
  // Bike info
  bikeBrand      String?
  bikeModel      String?
  nationalFileId String?
  shipAddress1   String?
  shipAddress2   String?
  shipZip        String?
  shipCity       String?
  shipCountry    String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bikes    CustomerBike[]
  bookings Booking[]
}

model Invoice {
  id              String    @id @default(cuid())
  workOrderId     String
  number          String?   @unique
  issueDate       DateTime?
  status          String    @default("draft")
  type            String    @default("invoice") // invoice | credit
  parentId        String?
  pricingMode     String    @default("HT_TVA")
  currency        String    @default("EUR")
  vatRate         Float     @default(20)
  laborRate       Float     @default(60)
  subtotalHT      Float     @default(0)
  vatAmount       Float     @default(0)
  totalTTC        Float     @default(0)
  discountAmount  Float?    @default(0)
  paidAt          DateTime?
  paymentMethod   String?
  cancelledAt     DateTime?
  cancelledReason String?
  dueDate         DateTime?
  reminderCount   Int       @default(0)
  lastReminderAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lines InvoiceLine[]
  payments InvoicePayment[]
}

model InvoiceLine {
  id              String  @id @default(cuid())
  invoiceId       String
  type            String  @default("part")
  description     String
  qty             Float   @default(1)
  unitPriceHT     Float?
  unitPriceTTC    Float?
  vatRate         Float?
  totalHT         Float   @default(0)
  totalTTC        Float   @default(0)
  partId          String?
  purchasePriceHT Float?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// Stock movement log
model StockMovement {
  id        String   @id @default(cuid())
  itemId    String
  type      String // IN | OUT | ADJUST
  qty       Int
  refType   String? // invoice | workOrder | directSale | manual | purchase
  refId     String?
  note      String?
  createdAt DateTime @default(now())

  item CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// Supplier directory
model Supplier {
  id            String   @id @default(cuid())
  name          String
  website       String?
  connectorType String   @default("MOCK")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items       SupplierItem[]
  credentials SupplierCredential[]
}

model SupplierCredential {
  id         String   @id @default(cuid())
  supplierId String
  userId     String
  username   String?
  password   String?
  extraJson  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model SupplierItem {
  id               String    @id @default(cuid())
  supplierId       String
  catalogItemId    String?
  supplierSku      String
  ean              String?
  lastPriceHT      Float?
  lastAvailability String?
  lastCheckedAt    DateTime?
  favorite         Boolean   @default(false)

  supplier    Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id])
}

// Minimal local WorkOrder for linking invoices
model WorkOrder {
  id         String    @id @default(cuid())
  status     String    @default("created")
  customerId String?
  bikeId     String?
  type       String?   @default("repair") // revision | repair | maintenance | upgrade
  createdAt  DateTime  @default(now())
  dueAt      DateTime?

  parts WorkOrderPart[]
}

model WorkOrderPart {
  id            String   @id @default(cuid())
  workOrderId   String
  catalogItemId String?
  description   String
  qty           Int      @default(1)
  priceHT       Float    @default(0)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workOrder   WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id])
}

// NextAuth.js Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // hashed password for credentials provider
  role          String    @default("user") // user | admin | technician | accountant
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  settings AppSetting?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Per-user application settings
model AppSetting {
  id          String   @id @default(cuid())
  userId      String   @unique
  shopName    String?
  shopEmail   String?
  shopPhone   String?
  address1    String?
  address2    String?
  zip         String?
  city        String?
  country     String?
  pdfPrimary  String? // hex color like #1976d2
  legalFooter String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Calendar: admin events visible internally; blocks that make time unavailable; client bookings
model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  start       DateTime
  end         DateTime
  status      String   @default("planned") // planned | in_progress | done | cancelled
  blocksAvail Boolean  @default(true) // if true, event time is not bookable
  color       String? // optional UI color
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CalendarBlock {
  id        String   @id @default(cuid())
  reason    String?
  start     DateTime
  end       DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id          String    @id @default(cuid())
  start       DateTime
  end         DateTime
  status      String    @default("pending") // pending | confirmed | cancelled | done
  // Client info
  name        String
  email       String?
  phone       String?
  bike        String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Link to customer (optional when created)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([start, end])
  @@index([customerId])
}

// Singleton config for calendar rules
model CalendarConfig {
  id             Int      @id @default(1)
  timezone       String   @default("Europe/Paris")
  slotMinutes    Int      @default(60)
  leadTimeHours  Int      @default(6)
  maxConcurrent  Int      @default(1)
  saturdayByAppt Boolean  @default(true)
  businessHours  String? // JSON string of weekly schedule
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
