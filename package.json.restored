    "license": "UNLICENSED",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/jeromeleyssard-pixel/atelier-velo-plus.git"
    },
    "main": "electron/index.js",
    "engines": {
        "node": ">=20 <23"
    },
    "engineStrict": true,
    "keywords": [
        "electron",
        "nextjs",
        "atelier",
        "velo",
        "gestion"
    ],
    "overrides": {
        "@img/sharp-win32-x64": "0.33.5",
        "@img/sharp-darwin-x64": "0.33.5",
        "@img/sharp-darwin-arm64": "0.33.5"
    },
    "scripts": {
        "dev": "next dev",
        "dev:tunnel": "powershell -ExecutionPolicy Bypass -File ./start-tunnel.ps1",
        "dev:electron": "wait-on tcp:3000 && cross-env NODE_ENV=development electron .",
        "dev:next": "next dev -p 3000",
        "dev:all": "concurrently \"npm run dev:next\" \"npm run dev:electron\"",
        "prebuild": "npx prisma generate",
        "build": "npx cross-env NODE_ENV=production next build",
        "postbuild": "node prepare-build-optimized.js",
        "postbuild:old": "node prepare-build.js",
        "prebuild:electron": "node -e \"console.log('Prebuild: Skipping cleanup on CI')\" || powershell -ExecutionPolicy Bypass -File ./prebuild-cleanup.ps1",
        "prebuild:electron:win": "powershell -ExecutionPolicy Bypass -File ./prebuild-cleanup.ps1",
        "version:increment": "node scripts/increment-version.js",
        "build:electron": "npm run prebuild:electron && electron-builder -c electron-builder.config.yml",
        "build:electron:safe": "powershell -ExecutionPolicy Bypass -File ./build-electron-safe.ps1",
        "build:electron:dev": "electron-builder -c electron-builder.dev.yml",
        "build:definitif": "powershell -ExecutionPolicy Bypass -File ./build-definitif.ps1",
        "build:dev": "powershell -ExecutionPolicy Bypass -File ./build-dev.ps1",
        "build:release": "powershell -ExecutionPolicy Bypass -File ./build-release.ps1",
        "start": "next start -p 3000",
        "start:prod": "cross-env NODE_ENV=production electron .",
        "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
        "lint:ci": "eslint . --max-warnings=0",
        "test": "npx jest",
        "test:watch": "npx jest --watch",
        "test:coverage": "npx jest --coverage",
        "test:unit": "npx jest --testPathPatterns=tests/unit",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug",
        "test:all": "npm run test:unit && npm run test:e2e",
        "postinstall": "npx prisma generate",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "clean": "rimraf .next out dist dist-electron electron-resources",
        "clean:all": "npm run clean && rimraf node_modules .cache",
        "typecheck": "rimraf .next/dev && tsc --noEmit",
        "format": "prettier -w .",
        "prisma:validate": "npx prisma validate",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:report": "playwright show-report",
        "test:build": "npm run build:definitif && npm run test:e2e",
        "icons:generate": "node ./scripts/generate-icons.mjs",
        "db:migrate": "npx prisma migrate dev",
        "db:generate": "npx prisma generate",
        "db:reset": "npx prisma generate && npx prisma migrate reset --force && npx prisma migrate dev",
        "db:studio": "npx prisma studio",
        "db:seed": "ts-node prisma/seed.ts",
        "audit:deps": "depcheck",
        "electron:dev": "electron .",
        "electron:kill": "powershell -ExecutionPolicy Bypass -File kill-electron.ps1"
    },
    "dependencies": {
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fullcalendar/daygrid": "^6.1.19",
        "@fullcalendar/interaction": "^6.1.19",
        "@fullcalendar/react": "^6.1.19",
        "@fullcalendar/timegrid": "^6.1.19",
        "@hubspot/api-client": "^13.4.0",
        "@mui/icons-material": "^5.15.0",
        "@mui/material": "^5.15.0",
        "@mui/x-data-grid": "^6.18.7",
        "@prisma/client": "^6.18.0",
        "@supabase/supabase-js": "^2.58.0",
        "@tanstack/react-query": "^5.90.5",
        "@tanstack/react-query-devtools": "^5.90.2",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^7.0.2",
        "@upstash/ratelimit": "^1.2.0",
        "@upstash/redis": "^1.35.5",
        "archiver": "^6.0.1",
        "axios": "^1.13.1",
        "bcryptjs": "^2.4.3",
        "check-disk-space": "^3.4.0",
        "date-fns": "^4.1.0",
        "dotenv": "^17.2.3",
        "electron-log": "^5.4.3",
        "electron-updater": "^6.6.2",
        "framer-motion": "^12.23.22",
        "fs-extra": "^11.3.2",
        "html5-qrcode": "^2.3.8",
        "hw-fingerprint": "^3.2.0",
        "jose": "^6.1.0",
        "jsonwebtoken": "^9.0.2",
        "micromatch": "^4.0.8",
        "next-electron-server": "^1.0.0",
        "node-cron": "^4.2.1",
        "node-machine-id": "^1.1.12",
        "nodemailer": "^7.0.9",
        "pdf-lib": "^1.17.1",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "recharts": "^3.3.0",
        "sharp": "^0.33.5",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@jest/globals": "^30.2.0",
        "@playwright/test": "^1.56.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@types/bcrypt": "^5.0.2",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^22.7.5",
        "@types/react": "^18.3.5",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/coverage-v8": "^3.2.4",
        "@vitest/ui": "^3.2.4",
        "7zip-bin": "^5.2.0",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "depcheck": "^1.4.7",
        "electron": "^39.1.2",
        "electron-builder": "^26.0.12",
        "electron-is-dev": "^3.0.1",
